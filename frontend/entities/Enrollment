  "properties": {
    "student_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "guardian_name": {
      "type": "string"
    },
    "guardian_id": {
      "type": "string"
    },
    "education_level": {
      "type": "string",
      "enum": [
        "infantil",
        "fundamental_1",
        "fundamental_2",
        "medio",
        "tecnico",
        "graduacao",
        "pos_graduacao"
      ]
    },
    "grade_level": {
      "type": "string",
      "description": "S\u00e9rie / Semestre / M\u00f3dulo"
    },
    "course": {
